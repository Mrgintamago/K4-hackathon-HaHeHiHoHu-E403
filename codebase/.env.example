DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Denylist áp dụng toàn guild. Khi bật @bot, ALLOWED_ROLE_IDS phải chứa ID role Learner.
DENIED_CHANNEL_IDS=
ALLOWED_ROLE_IDS=
RATE_LIMIT_SECONDS=5

# Hỏi bằng @bot. Nên giới hạn vào các channel học tập cụ thể.
ENABLE_MENTION_QA=false
MENTION_ALLOWED_CHANNEL_IDS=

# Lịch và reminder. Luôn dùng ID, không dùng tên channel/role.
ENABLE_DAILY_REMINDER=false
# Channel nguồn chứa thông báo lịch chính thức.
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
# Khi có ID này, daily learning reminder chỉ gửi vào channel chung này.
# Nếu để trống, bot mới gửi tới các channel trong USER_PERSONAL_CHANNEL_MAP.
DISCORD_REMINDER_CHANNEL_ID=222222222222222222
DISCORD_MANAGER_ROLE_IDS=
REMINDER_HOUR=8
REMINDER_MINUTE=0
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh

# OpenAI Platform API (không dùng token đăng nhập Codex/ChatGPT)
OPENAI_API_KEY=
# Model Responses API ưu tiên chất lượng tóm tắt và tuân thủ guardrail.
OPENAI_MODEL=gpt-5.6-terra

# Thư mục PRIVATE chứa transcript. Không commit data pack.
# Daily gắn WS2 là hôm qua; @bot vẫn có thể hỏi WS1/WS2 theo chủ đề.
TRANSCRIPT_DIR=../../data/vlearn-pack/transcript
MAX_CONTEXT_CHARS=130000
AI_TIMEOUT_MS=30000

# Tùy chọn: gửi daily reminder từ Discord bot sang Pixel Pet local server.
ENABLE_PIXEL_PET_NOTIFIER=false
PIXEL_PET_NOTIFICATION_URL=http://localhost:8765/api/notifications
# Dùng cùng giá trị với local-server; không commit secret thật.
PIXEL_PET_TOKEN=

# Bài học private: tên file theo dd.mm.yyyy-ngayN.pdf, ví dụ 30.07.2026-ngay5.pdf.
# File list.md cùng thư mục ánh xạ theo dạng: ngay5: https://vlearn.dev/...
# Bot chỉ đọc tối đa 3 trang đầu tại chỗ và không hiển thị tên file cho user.
# Không đặt PDF hoặc list private trong repo.
LESSON_PDF_DIR=../pdf

# Daily Standup lấy từ channel team và có thể nhận form trong channel thông báo chung.
ENABLE_STANDUP_REMINDER=false
TEAM_STANDUP_CHANNEL_MAP=T203:111111111111111111,T204:222222222222222222
# Ánh xạ team sang số nhóm để log có dạng G-số nhóm -> T-số team -> user.
TEAM_STANDUP_GROUP_MAP=T203:G1,T204:G1
STANDUP_REMINDER_HOUR=21
STANDUP_REMINDER_MINUTE=30
STANDUP_MANAGER_ROLE_IDS=
USER_PERSONAL_CHANNEL_MAP=123456789012345678:333333333333333333

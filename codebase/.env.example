DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Bot hoạt động ở mọi channel trong guild, TRỪ các channel/category dưới đây.
# Nhiều Discord ID ngăn cách bằng dấu phẩy. Thread cũng bị chặn nếu parent bị chặn.
DENIED_CHANNEL_IDS=

# Tùy chọn: chỉ các role này được gọi bot. Để trống = mọi role trong guild.
ALLOWED_ROLE_IDS=
RATE_LIMIT_SECONDS=30

# OpenAI Platform API (không dùng token đăng nhập Codex/ChatGPT)
OPENAI_API_KEY=
# Model nhỏ, rẻ và phù hợp summarization
OPENAI_MODEL=gpt-5-nano

# Thư mục PRIVATE chứa transcript. Không commit data pack.
TRANSCRIPT_DIR=../../data/vlearn-pack/transcript
MAX_CONTEXT_CHARS=130000
AI_TIMEOUT_MS=30000
